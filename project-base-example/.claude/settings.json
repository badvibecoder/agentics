{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(ansible --version)",
      "Bash(ansible-lint --version)"
    ],
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=* of=/dev/sd*)",
      "Bash(:(){ :|:& };:)"
    ],
    "defaultMode": "default",
    "additionalDirectories": []
  },
  "respectGitignore": true
}
